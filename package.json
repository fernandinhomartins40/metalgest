{
  "name": "metalgest",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test:api": "npm run test --workspace @metalgest/api",
    "smoke:docker": "node ./scripts/smoke-test.mjs",
    "clean": "turbo run clean",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose down && docker-compose up -d"
  },
  "devDependencies": {
    "@types/node": "^20.8.3",
    "turbo": "^1.10.16",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.0.0",
  "description": "MetalGest - Sistema de Gestão Empresarial (Monorepo)",
  "keywords": [
    "metalgest",
    "gestão",
    "erp",
    "react",
    "vite",
    "monorepo",
    "turborepo"
  ]
}
